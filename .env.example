# =====================================================================
# AturModal - Environment Configurations Example
# =====================================================================
# Copy this file to '.env' and fill in your values.
# Do NOT commit the actual '.env' file to version control.

# ---------------------------------------------------------------------
# Google Gemini API Configuration
# ---------------------------------------------------------------------
# Generate your API Key at Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Timeout in seconds for Gemini API requests
GEMINI_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# Connection URI format: postgresql+asyncpg://[user]:[password]@[host]:[port]/[database]
# For local PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aturmodal
# For Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/aturmodal

# ---------------------------------------------------------------------
# Redis Configuration (Required for Rate Limiting)
# ---------------------------------------------------------------------
# For local Redis:
REDIS_URL=redis://localhost:6379
# For Docker:
# REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------
# Security & JWT Configuration
# ---------------------------------------------------------------------
# Generate a secure 64-char key using: openssl rand -hex 32
JWT_SECRET_KEY=b30beb29bf301e4e6f94c1a6a74bc6bdf00fdb17ee11f197f83254e870871de6
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------
# Application Environment
# ---------------------------------------------------------------------
APP_ENV=development # development, testing, production
APP_HOST=0.0.0.0
APP_PORT=8082
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:8082
