# Salin file ini menjadi .env dan isi nilainya
# Jangan pernah commit file .env ke repository

# ===================================
# Wajib: API Key Google Gemini
# ===================================
GEMINI_API_KEY=your_gemini_api_key_here

# ===================================
# Opsional: URL Redis (default: redis://localhost:6379)
# ===================================
REDIS_URL=redis://localhost:6379

# ===================================
# Sprint 2: Database PostgreSQL
# ===================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dapurprofit

# ===================================
# Sprint 2: JWT Authentication
# ===================================
# WAJIB diganti di production — gunakan string random minimal 64 karakter
# Contoh generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=ganti-dengan-random-string-minimal-64-karakter-di-production
JWT_EXPIRE_MINUTES=1440

# ===================================
# Sprint 3: Reliability & Deployment
# ===================================
# Timeout pemanggilan Gemini per request (detik)
GEMINI_TIMEOUT_SECONDS=30

# Environment identifier (development / production)
ENVIRONMENT=development
